# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit it.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
# Always set to production in deployed environments
ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://simtrader:CHANGE_ME@localhost:5432/simtrader?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_RANDOM_HEX
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ── Internal secret (psx_tracker → backend webhook) ──────────────────────────
# Must match INTERNAL_SECRET in psx_tracker's environment.
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX

# ── First admin account ───────────────────────────────────────────────────────
# REQUIRED in production — the server refuses to boot without both. There is no
# shipped default password; the seed admin ships blocked.
# Leave blank ONLY in local development: a random admin password is generated and
# printed once to the backend console on first boot.
ADMIN_EMAIL=admin@iba.edu.pk
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD   # 12+ chars, not a common password

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Used for invite and password-reset emails.
# In development, tokens are printed to console (no SMTP needed).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=YOUR_RESEND_API_KEY
EMAIL_FROM=noreply@yourdomain.com

# ── Frontend URL (CORS + email links) ─────────────────────────────────────────
# Must match the URL students use to access the app.
# Use https:// in production.
FRONTEND_URL=https://simtrader.iba.edu.pk
