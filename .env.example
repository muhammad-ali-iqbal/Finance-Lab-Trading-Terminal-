# Copy this file to .env and fill in the values before running docker compose.
#
# Generate secrets with:
#   openssl rand -hex 64    ← for JWT secrets
#   openssl rand -hex 32    ← for INTERNAL_SECRET and POSTGRES_PASSWORD

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_this_to_a_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Internal API secret (psx_tracker → backend) ───────────────────────────────
INTERNAL_SECRET=

# ── Frontend URL (used for CORS) ──────────────────────────────────────────────
# Set to http://your-server-ip or https://your-domain.com in production.
# Leave as http://localhost for local development.
FRONTEND_URL=http://localhost

# ── Email (optional — leave blank to print invite tokens to the backend log) ──
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com
